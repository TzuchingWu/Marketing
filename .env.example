# Optional. If set, the agent workflow lets Claude choose which MCP tools
# to call and generates richer natural-language text (business explanations,
# outreach messages, campaign ideas). Without it, the app runs in fully
# offline "scripted" mode: the same MCP tools are called in a fixed order,
# and text generation falls back to templates. Creator scoring is always
# deterministic and never depends on this key.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Server-side key for Google Places/Maps lookups (e.g. real
# business geocoding). Restrict this key in Google Cloud Console to only
# the APIs you use (Places API / Geocoding API) and to your server's IP
# address -- never ship it to browser/frontend code, since a key embedded
# in client-side JS is visible to anyone who views page source.
GOOGLE_MAPS_API_KEY=

# Optional. HubSpot Service Key / Private App access token -- used to log
# creator outreach as CRM contacts + notes, so outreach status across many
# creators can be tracked in HubSpot instead of being lost after this
# session ends. This never sends anything itself, only records that
# outreach happened. Required scopes: crm.objects.contacts.read,
# crm.objects.contacts.write.
HUBSPOT_ACCESS_TOKEN=

# Optional. Google Veo API key (Gemini API long-running-operation
# endpoint, simple API-key auth -- not Vertex AI's OAuth/service-account
# path). Used only by generate_video_ad, an explicitly opt-in tool that
# generates a real short AI video clip. Real per-clip cost, NO FREE TIER
# -- billing must be enabled on the Google AI Studio / Cloud project for
# this key, or every request fails with 429 RESOURCE_EXHAUSTED even on
# the very first call. Generation is an async job that can take 30s-few
# minutes. Without this set (or if billing isn't enabled), generate_video_ad
# still returns the ad concept (angle/scenes/prompt) with video.status
# = "not_configured" / "failed".
GOOGLE_VEO_API_KEY=

# Optional. Run `GET https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY`
# to see which Veo models your key actually has access to -- it varies
# per account/rollout. Defaults to veo-3.1-fast-generate-preview.
VEO_MODEL=veo-3.1-fast-generate-preview

# Optional. OpenAI API key, used only by the explicitly opt-in
# search_real_creators tool to find REAL, currently-active creators via
# OpenAI's web search tool -- not the demo dataset. Web search can only
# verify a creator's platform/handle/name/bio/approximate follower count;
# it can NEVER verify engagement rate, audience demographics, or
# collaboration cost (not public data), so those come back unknown
# rather than fabricated. Real cost per search, no free tier. Without
# this set, search_real_creators returns an empty list and callers
# should fall back to the demo dataset's search_creators.
OPEN_AI_WEBSEARCH_API_KEY=

# Optional. Must be a model that supports the Responses API "web_search"
# tool. Defaults to gpt-4o.
OPEN_AI_WEBSEARCH_MODEL=gpt-4o
